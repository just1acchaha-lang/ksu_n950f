#!/bin/bash
# JUST1ACCHAHALANG-GREATLTE-BUILD

# Variables
DIR="$(pwd)"
KERNEL_DIR="$DIR/kernel"
OUT_DIR="$KERNEL_DIR/out"
ANYKERNEL="$KERNEL_DIR/AnyKernel3"
# CORRECTED DEFCONFIG NAME
DEFCONFIG="exynos8895-greatlte_defconfig"

echo "Cloning dependencies for Note 8 (greatlte)"
git clone --depth=1 --branch lineage-20.0 https://github.com/just1acchaha-lang/android_kernel_samsung_universal8895 kernel
cd kernel 

# Toolchains
git clone --depth=1 --branch android-11.0.0_r48 https://android.googlesource.com/platform/prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9 aarch64-linux-android-4.9
git clone --depth=1 https://github.com/prorooter007/android_prebuilts_clang_host_linux-x86_clang-6877366 clang-r383902
git clone --depth=1 https://github.com/osm0sis/AnyKernel3 AnyKernel3

# Environment Setup
export ARCH=arm64
export CROSS_COMPILE="$(pwd)/aarch64-linux-android-4.9/bin/aarch64-linux-android-"
export CLANG_TRIPLE="$(pwd)/clang-r383902/bin/aarch64-linux-gnu-"
export PATH="$(pwd)/aarch64-linux-android-4.9/bin:$(pwd)/clang-r383902/bin:$PATH"
export LLVM=1

# Colors
BGREEN="\033[1;32m"
BRED="\033[1;31m"
STD="\033[0m"
 
build_kernel(){  
  echo -e "${BGREEN}***** Compiling for $DEFCONFIG *****${STD}"
  mkdir -p $OUT_DIR
  
  # Clean and configure using the correct filename
  make -j$(nproc) O=out clean
  make -j$(nproc) O=out $DEFCONFIG
  
  # Compile
  make -j$(nproc) O=out

  # Check for output
  if [ -f "out/arch/arm64/boot/Image.gz-dtb" ]; then
    echo -e "${BGREEN}***** Build Successful! *****${STD}"
    
    cd $ANYKERNEL
    git reset --hard
    cp ../out/arch/arm64/boot/Image.gz-dtb zImage
    
    # Branding
    sed -i "s/ExampleKernel by osm0sis/Just1Acc-Kernel for Note8/g" anykernel.sh
    # Set the Note 8 block path for LineageOS/AOSP
    sed -i "s|block=/dev/block/td8|block=/dev/block/platform/11120000.ufs/by-name/BOOT|g" anykernel.sh
    
    zip -r9 "$DIR/Just1Acc-Note8-Kernel.zip" * -x .git README.md *placeholder
    echo -e "${BGREEN}***** Success! Zip: Just1Acc-Note8-Kernel.zip *****${STD}"
  else
    echo -e "${BRED}***** Build Failed! Check for errors in the terminal. *****${STD}"
    exit 1
  fi
}

build_kernel
